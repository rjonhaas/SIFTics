.DS_Store

# Local Claude Code session state
.claude/

# Python bytecode (from running Python helper scripts)
__pycache__/
*.pyc

# Secrets — NEVER commit
token.txt
*.token
*.pem
*.key
.env
.env.*

# MCP server build output
protocol-sift-ics/mcp-server/dist/

# Node deps (lockfile is committed; modules are not)
**/node_modules/

# Per-incident artifacts written by scripts/run-incident.sh
protocol-sift-ics/.directive-*.json
protocol-sift-ics/.preflight-*.json

# Orchestrator build output
protocol-sift-ics/orchestrator/dist/

# Auto-generated session audit log
analysis/forensic_audit.log

# MCP broker venv + per-call audit log + local config
mcp_broker/.venv/
mcp_broker/audit.jsonl
mcp_broker/config/config.yaml
mcp_broker/config/velociraptor_api_key.json
